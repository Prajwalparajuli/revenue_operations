{
  "datasets": [
    {
      "name": "b62ecefa",
      "displayName": "Model Performance Ranking Overview",
      "queryLines": [
        "SELECT\n",
        "  REPLACE(\n",
        "    REPLACE(UPPER(REPLACE(model_name, '_', ' ')), ' W ', '\\nW '),\n",
        "    'ENSEMBLE ',\n",
        "    'ENSEMBLE\\n'\n",
        "  ) AS model_name,\n",
        "  model_type,\n",
        "  val_f1,\n",
        "  val_precision,\n",
        "  val_recall,\n",
        "  val_roc_auc,\n",
        "  val_pr_auc,\n",
        "  val_top10_capture,\n",
        "  train_f1,\n",
        "  test_pr_auc,\n",
        "  test_f1,\n",
        "  created_at,\n",
        "  run_id,\n",
        "  overfitting_gap,\n",
        "  train_duration_sec,\n",
        "  model_size_mb,\n",
        "  latency_p50_ms,\n",
        "  latency_p95_ms,\n",
        "  batch_throughput_rps,\n",
        "  orders_inspected,\n",
        "  late_orders_caught,\n",
        "  gross_loss_prevented,\n",
        "  intervention_cost,\n",
        "  net_business_value,\n",
        "  composite_score,\n",
        "  deployment_status\n",
        "FROM\n",
        "  revenue_operations.gold.model_evaluation_leaderboard\n",
        "WHERE\n",
        "  model_type != 'champion_ensemble_lr_xgb'"
      ],
      "catalog": "revenue_operations",
      "schema": "gold"
    },
    {
      "name": "480e6cc0",
      "displayName": "Top performing model",
      "queryLines": [
        "SELECT\n",
        "  REPLACE(\n",
        "    REPLACE(UPPER(REPLACE(model_name, '_', ' ')), ' W ', '\\nW '),\n",
        "    'ENSEMBLE ',\n",
        "    'ENSEMBLE\\n'\n",
        "  ) AS formatted_model_name,\n",
        "  val_top10_capture,\n",
        "  net_business_value\n",
        "FROM\n",
        "  revenue_operations.gold.model_evaluation_leaderboard\n",
        "ORDER BY\n",
        "  val_top10_capture DESC\n",
        "LIMIT 1"
      ]
    },
    {
      "name": "b5f1fd9c",
      "displayName": "p95 latency",
      "queryLines": [
        "SELECT  REPLACE(\r\n",
        "    REPLACE(UPPER(REPLACE(model_name, '_', ' ')), ' W ', '\\nW '),\r\n",
        "    'ENSEMBLE ',\r\n",
        "    'ENSEMBLE\\n'\r\n",
        "  ) AS model_name, latency_p95_ms\r\n",
        "FROM revenue_operations.gold.model_evaluation_leaderboard\r\n",
        "WHERE latency_p95_ms IS NOT NULL\r\n",
        "ORDER BY latency_p95_ms \r\n",
        "LIMIT 2\r\n"
      ]
    },
    {
      "name": "977fbf5b",
      "displayName": "ROC AUC",
      "queryLines": [
        "SELECT  REPLACE(\r\n",
        "    REPLACE(UPPER(REPLACE(model_name, '_', ' ')), ' W ', '\\nW '),\r\n",
        "    'ENSEMBLE ',\r\n",
        "    'ENSEMBLE\\n'\r\n",
        "  ) AS model_name, val_roc_auc\r\n",
        "FROM revenue_operations.gold.model_evaluation_leaderboard\r\n",
        "WHERE val_roc_auc IS NOT NULL\r\n",
        "ORDER BY val_roc_auc DESC\r\n",
        "LIMIT 1"
      ]
    },
    {
      "name": "de3fd20e",
      "displayName": "PR AUC",
      "queryLines": [
        "SELECT  REPLACE(\r\n",
        "    REPLACE(UPPER(REPLACE(model_name, '_', ' ')), ' W ', '\\nW '),\r\n",
        "    'ENSEMBLE ',\r\n",
        "    'ENSEMBLE\\n'\r\n",
        "  ) AS model_name, val_pr_auc\r\n",
        "FROM revenue_operations.gold.model_evaluation_leaderboard\r\n",
        "WHERE val_pr_auc IS NOT NULL\r\n",
        "ORDER BY val_pr_auc DESC\r\n",
        "LIMIT 1\r\n"
      ]
    }
  ],
